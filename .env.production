# Vite bakes this in at build time. Loaded automatically by `vite build`
# (default mode "production") for every Cloudflare Workers Build deploy.
# Not a secret - just the real backend's public base URL. Missing this
# file previously caused the app to silently fall back to the unresolvable
# https://api-dev.zestcomply.com/v1 default in src/lib/api/config.ts,
# breaking every API call on the live site (login, signup, password reset,
# request access, etc.) with "Load failed" / "Failed to fetch" errors.
VITE_API_URL=https://api.zestcomply.com/v1
